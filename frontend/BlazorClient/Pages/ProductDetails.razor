    private bool isAdding = false;

    private async Task AddToCart()
    {
        if (product == null) return;
        
        isAdding = true;
        try
        {
            var cartItem = new CartItem
            {
                ProductId = product.Id,
                ProductTitle = product.Title ?? "Product",
                ProductImage = product.ImageName,
                Price = product.Price,
                DisplayPrice = product.DisplayPrice,
                DisplayCurrency = product.DisplayCurrency,
                Quantity = quantity,
                IsDigital = product.IsDigital,
                IsSubscription = product.IsSubscription,
                
                // Shipping selection
                SelectedShippingServiceId = selectedShippingQuote?.Id,
                SelectedShippingName = selectedShippingQuote?.Name,
                SelectedShippingCompany = selectedShippingQuote?.Company,
                SelectedShippingPrice = selectedShippingQuote != null ? (decimal)selectedShippingQuote.Price : null,
                SelectedShippingDeliveryTime = selectedShippingQuote?.DeliveryTime,
                SelectedShippingDescription = selectedShippingQuote?.Description
            };

            await CartService.AddToCart(cartItem);
             // Show feedback (Snackbar injected implicitly via MainLayout or explicitly here if we want)
             // But usually CartService handles toast or we do it here.
             // We'll trust CartService or Component to handle it, but adding a snackbar here implies standardizing usage.
        }
        catch (Exception ex)
        {
             Console.WriteLine(ex.Message);
        }
        finally
        {
            isAdding = false;
        }
    }
    
    private async Task CopyLink()
    {
        var lang = L.CurrentLanguage;
        var uriBuilder = new UriBuilder(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uriBuilder.Query);
        query["lang"] = lang;
        uriBuilder.Query = query.ToString();
        
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", uriBuilder.ToString());
    }

    private async Task ShareToWhatsapp()
    {
         var lang = L.CurrentLanguage;
         var uri = Navigation.Uri;
         if (!uri.Contains("?")) uri += $"?lang={lang}";
         else if (!uri.Contains("lang=")) uri += $"&lang={lang}";

         var url = System.Net.WebUtility.UrlEncode(uri);
         var title = System.Net.WebUtility.UrlEncode(GetTranslatedTitle());
         await JSRuntime.InvokeVoidAsync("window.open", $"https://api.whatsapp.com/send?text={title}%20{url}", "_blank");
    }

