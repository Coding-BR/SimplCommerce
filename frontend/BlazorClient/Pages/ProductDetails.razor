        }
        return product.Description ?? string.Empty;
    }

    private string GetTranslatedFullDesc()
    {
         if (product == null) return string.Empty;
        var lang = L.CurrentLanguage;
        // Assuming FullDescription is in the translation map or separate property? 
        // The Model 'Product' has Translations dictionary with ProductTranslation.
        // Let's assume ProductTranslation has FullDescription. If not, fallback to Description.
        if (product.Translations != null && product.Translations.TryGetValue(lang, out var trans))
        {
            // If the model doesn't have FullDescription, just use Description or add it to model. 
            // Based on previous files, logic used Description. 
            return trans.Description ?? string.Empty; 
        }
        return product.Description ?? string.Empty;
    }

