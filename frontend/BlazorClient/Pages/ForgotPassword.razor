@page "/forgot-password"
@inject IAuthService AuthService

<PageTitle>Recuperar senha | IdealCreative</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="ic-auth-page">
    <MudPaper Elevation="0" Class="ic-auth-card pa-8 bg-white">
        <div class="ic-auth-brand"><span>i</span><strong>ideal<em>creative</em></strong></div>
        <div class="text-center mb-8">
            <MudText Typo="Typo.h4" Class="fw-bold mb-2">Recuperar senha</MudText>
            <MudText Typo="Typo.body2" Class="ynex-text-muted">Informe seu e-mail para receber um link seguro de redefinição.</MudText>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@(success ? Severity.Success : Severity.Error)" Variant="Variant.Filled" Class="mb-6 rounded-lg ynex-alert">@message</MudAlert>
        }

        <EditForm Model="@model" OnValidSubmit="RequestReset">
            <DataAnnotationsValidator />
            <MudTextField @bind-Value="model.Email" Label="E-mail" Variant="Variant.Outlined" InputType="InputType.Email" Immediate="true" Placeholder="seu@email.com" For="@(() => model.Email)" FullWidth="true" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6 py-3 rounded-xl fw-bold" Disabled="@sending">
                @if (sending) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> <span class="ms-2">Enviando...</span> }
                else { <span>Enviar link de recuperação</span> }
            </MudButton>
        </EditForm>

        <div class="text-center mt-8">
            <MudLink Href="/login" Underline="Underline.None" Color="Color.Primary" Class="fw-bold">Voltar para entrar</MudLink>
        </div>
        <div class="ic-auth-trust"><span><i class="icon-lock"></i> Link válido por 1 hora</span><span><i class="icon-check"></i> Uso único</span></div>
    </MudPaper>
</MudContainer>

@code {
    private readonly ForgotPasswordModel model = new();
    private bool sending;
    private bool success;
    private string? message;

    private async Task RequestReset()
    {
        sending = true;
        message = null;
        var result = await AuthService.RequestPasswordReset(model.Email);
        sending = false;
        success = result.Success;
        message = result.Success
            ? result.Message ?? "Se existir uma conta ativa com este e-mail, enviaremos as instruções para redefinir sua senha."
            : result.Error ?? "Não foi possível solicitar a recuperação de senha.";
    }

    private sealed class ForgotPasswordModel
    {
        [Required(ErrorMessage = "E-mail é obrigatório")]
        [EmailAddress(ErrorMessage = "E-mail inválido")]
        public string Email { get; set; } = string.Empty;
    }
}
