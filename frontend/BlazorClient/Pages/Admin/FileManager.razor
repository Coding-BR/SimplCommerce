@using BlazorClient.Core.Interfaces
@page "/admin/files"
@using BlazorClient.Models
@using BlazorClient.Core.Services
@inject IProductService ProductService
@inject IJSRuntime JSRuntime
@inject ILocalizationService L
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]

<div class="container-fluid ic-admin-page">
    <div class="admin-page-header ic-admin-page-heading d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="ic-admin-kicker">ARMAZENAMENTO</span>
            <h1 class="mb-1">Gerenciador de arquivos</h1>
            <p class="mb-0 text-muted">Organize imagens, vetores e arquivos digitais armazenados no Cloudflare R2 / S3.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <InputFile id="directFileInput" OnChange="HandleFileSelected" class="d-none" />
            <label for="directFileInput" class="btn btn-primary px-4 d-inline-flex align-items-center gap-2 shadow-sm" style="cursor: pointer;">
                @if (isUploading)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span>Enviando...</span>
                }
                else
                {
                    <i class="fa fa-upload"></i>
                    <span>Enviar Arquivo</span>
                }
            </label>
            <button class="btn btn-outline-secondary px-3" @onclick="Refresh" title="Atualizar lista">
                <i class="fa fa-refresh"></i>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert @(isStatusError ? "alert-danger" : "alert-success") alert-dismissible fade show" role="alert">
            <i class="fa @(isStatusError ? "fa-exclamation-triangle" : "fa-check-circle") me-2"></i> @statusMessage
            <button type="button" class="btn-close" @onclick='() => statusMessage = null'></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-light py-3">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
                <!-- Breadcrumb Navigation -->
                <nav aria-label="breadcrumb" class="flex-grow-1">
                    <ol class="breadcrumb mb-0 align-items-center">
                        <li class="breadcrumb-item">
                            <a href="javascript:void(0)" class="text-decoration-none fw-semibold text-primary" @onclick='() => NavigateTo("")'>
                                <i class="fa fa-home"></i> Raiz
                            </a>
                        </li>
                        @foreach (var crumb in GetBreadcrumbs())
                        {
                            <li class="breadcrumb-item">
                                <a href="javascript:void(0)" class="text-decoration-none text-secondary" @onclick='() => NavigateTo(crumb.Path)'>
                                    @crumb.Name
                                </a>
                            </li>
                        }
                    </ol>
                </nav>
                
                <!-- Search Input -->
                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text bg-white text-muted"><i class="fa fa-search"></i></span>
                    <input type="text" class="form-control border-start-0" placeholder="Buscar no diretório..." 
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                            <i class="fa fa-times"></i>
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2 small">Carregando arquivos do Cloudflare R2...</p>
                </div>
            }
            else if (browserResponse == null || (!browserResponse.Items.Any()))
            {
                <div class="text-center py-5 text-muted">
                    <i class="fa fa-folder-open-o fa-3x mb-3 text-secondary opacity-50"></i>
                    <p class="mb-0 fs-6">@(string.IsNullOrEmpty(searchTerm) ? "Este diretório está vazio." : "Nenhum arquivo encontrado para a busca.")</p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var item in browserResponse.Items.OrderByDescending(i => i.IsFolder).ThenBy(i => i.Name))
                    {
                        <div class="list-group-item list-group-item-action py-3 px-4 d-flex justify-content-between align-items-center gap-3">
                            <div class="d-flex align-items-center gap-3 flex-grow-1 overflow-hidden" style="cursor: pointer;" @onclick="() => OnItemClick(item)">
                                <div class="flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; border-radius: 8px; background: #f8f9fa;">
                                    @if (item.IsFolder)
                                    {
                                        <i class="fa fa-folder fa-2x text-warning"></i>
                                    }
                                    else if (IsImageFile(item.Name))
                                    {
                                        <img src="@GetFilePreviewUrl(item.Key)" alt="@item.Name" style="width: 48px; height: 48px; object-fit: cover; border-radius: 8px;" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-block';" />
                                        <i class="fa fa-file-image-o fa-2x text-primary" style="display: none;"></i>
                                    }
                                    else if (item.Name.EndsWith(".zip", StringComparison.OrdinalIgnoreCase) || item.Name.EndsWith(".rar", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="fa fa-file-archive-o fa-2x text-danger"></i>
                                    }
                                    else if (item.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <i class="fa fa-file-pdf-o fa-2x text-danger"></i>
                                    }
                                    else
                                    {
                                        <i class="fa fa-file-o fa-2x text-info"></i>
                                    }
                                </div>
                                <div class="overflow-hidden">
                                    <h6 class="mb-0 text-truncate fw-semibold">@CleanName(item.Name)</h6>
                                    @if (!item.IsFolder)
                                    {
                                        <small class="text-muted">
                                            @FormatSize(item.Size) @(item.LastModified.HasValue ? $"• {L.FormatDateTime(item.LastModified.Value)}" : "")
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">Pasta</small>
                                    }
                                </div>
                            </div>
                            
                            @if (!item.IsFolder)
                            {
                                <div class="btn-group flex-shrink-0">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyUrl(item)" @onclick:stopPropagation="true" title="Copiar URL">
                                        <i class="fa fa-copy"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-info" @onclick="() => InspectFile(item.Key)" @onclick:stopPropagation="true" title="Inspecionar detalhes">
                                        <i class="fa fa-info-circle"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => DownloadFile(item)" @onclick:stopPropagation="true" title="Baixar">
                                        <i class="fa fa-download"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteFile(item)" @onclick:stopPropagation="true" title="Excluir">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
        
        <!-- Pagination Footer -->
        @if (browserResponse != null && browserResponse.Items.Any())
        {
            <div class="card-footer bg-light py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    Exibindo <strong>@browserResponse.Items.Count</strong> itens@(browserResponse.TotalItems > 0 ? $" de {browserResponse.TotalItems}" : "")
                </div>
                <div class="btn-group">
                    <button class="btn btn-outline-primary btn-sm px-3" @onclick="PreviousPage" disabled="@(tokenHistory.Count == 0)">
                        <i class="fa fa-chevron-left me-1"></i> Anterior
                    </button>
                    <button class="btn btn-outline-primary btn-sm px-3" @onclick="NextPage" disabled="@(!browserResponse.HasMore)">
                        Próxima <i class="fa fa-chevron-right ms-1"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Inspection -->
@if (showInspectionModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa fa-info-circle text-primary me-2"></i> Detalhes do Arquivo</h5>
                    <button type="button" class="btn-close" @onclick="CloseInspectionModal"></button>
                </div>
                <div class="modal-body">
                    <pre class="p-3 bg-dark text-success rounded" style="max-height: 350px; overflow-y: auto;"><code>@inspectionResult</code></pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary px-4" @onclick="CloseInspectionModal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private B2BrowserResponse? browserResponse;
    private string currentPath = "";
    private bool isLoading = false;
    private bool isUploading = false;
    private string? statusMessage;
    private bool isStatusError = false;
    
    // Search & Pagination
    private string searchTerm = "";
    private string? currentContinuationToken = null;
    private Stack<string?> tokenHistory = new();
    private System.Timers.Timer? searchDebounceTimer;
    
    // Inspection
    private bool showInspectionModal = false;
    private string inspectionResult = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadFiles();
    }

    private async Task Refresh()
    {
        currentContinuationToken = null;
        tokenHistory.Clear();
        await LoadFiles();
    }

    private async Task LoadFiles()
    {
        isLoading = true;
        StateHasChanged();
        browserResponse = await ProductService.BrowseFilesAsync(currentPath, 50, currentContinuationToken, searchTerm);
        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        isUploading = true;
        statusMessage = null;
        StateHasChanged();

        var success = await ProductService.UploadFileToPathAsync(file, currentPath);
        isUploading = false;

        if (success)
        {
            statusMessage = $"Arquivo \"{file.Name}\" enviado com sucesso!";
            isStatusError = false;
            await Refresh();
        }
        else
        {
            statusMessage = $"Erro ao enviar o arquivo \"{file.Name}\". Tente novamente.";
            isStatusError = true;
            StateHasChanged();
        }
    }

    private async Task NavigateTo(string path)
    {
        currentPath = path;
        currentContinuationToken = null;
        tokenHistory.Clear();
        searchTerm = "";
        await LoadFiles();
    }

    private async Task OnItemClick(B2FileItem item)
    {
        if (item.IsFolder)
        {
            await NavigateTo(item.Key);
        }
    }

    private List<(string Name, string Path)> GetBreadcrumbs()
    {
        var crumbs = new List<(string Name, string Path)>();
        if (string.IsNullOrEmpty(currentPath)) return crumbs;

        var unescaped = Uri.UnescapeDataString(currentPath).TrimEnd('/');
        var parts = unescaped.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var builtPath = "";
        
        foreach (var part in parts)
        {
            builtPath += part + "/";
            crumbs.Add((part, builtPath));
        }
        
        return crumbs;
    }

    private static string CleanName(string rawName)
    {
        if (string.IsNullOrWhiteSpace(rawName)) return "";
        var unescaped = Uri.UnescapeDataString(rawName).TrimEnd('/');
        var idx = unescaped.LastIndexOf('/');
        return idx >= 0 ? unescaped[(idx + 1)..] : unescaped;
    }

    private static bool IsImageFile(string fileName)
    {
        var ext = Path.GetExtension(fileName).ToLowerInvariant();
        return ext is ".jpg" or ".jpeg" or ".png" or ".webp" or ".gif" or ".svg" or ".avif";
    }

    private static string GetFilePreviewUrl(string key)
    {
        return $"/api/storage/public?path={Uri.EscapeDataString(key)}";
    }

    private async Task CopyUrl(B2FileItem item)
    {
        var url = GetFilePreviewUrl(item.Key);
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
        statusMessage = $"URL copiada para a área de transferência: {url}";
        isStatusError = false;
        StateHasChanged();
    }

    private string FormatSize(long bytes)
    {
        if (bytes <= 0) return "0 B";
        string[] sizes = { "B", "KB", "MB", "GB", "TB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }
    
    private void OnSearchKeyUp()
    {
        searchDebounceTimer?.Stop();
        searchDebounceTimer?.Dispose();
        
        searchDebounceTimer = new System.Timers.Timer(400);
        searchDebounceTimer.Elapsed += async (s, e) =>
        {
            searchDebounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                currentContinuationToken = null;
                tokenHistory.Clear();
                await LoadFiles();
            });
        };
        searchDebounceTimer.AutoReset = false;
        searchDebounceTimer.Start();
    }
    
    private async Task ClearSearch()
    {
        searchTerm = "";
        currentContinuationToken = null;
        tokenHistory.Clear();
        await LoadFiles();
    }
    
    private async Task NextPage()
    {
        if (browserResponse?.HasMore == true && !string.IsNullOrEmpty(browserResponse.ContinuationToken))
        {
            tokenHistory.Push(currentContinuationToken);
            currentContinuationToken = browserResponse.ContinuationToken;
            await LoadFiles();
        }
    }
    
    private async Task PreviousPage()
    {
        if (tokenHistory.Count > 0)
        {
            currentContinuationToken = tokenHistory.Pop();
            await LoadFiles();
        }
    }
    
    private async Task InspectFile(string path)
    {
        var details = await ProductService.InspectFileVersionsAsync(path);
        if (details != null)
        {
           inspectionResult = $"🔍 Relatório de Inspeção de Arquivo\n\n" +
                         $"Caminho: {details.Path}\n" +
                         $"Versões ativas: {details.VersionCount}\n" +
                         $"Marcadores de exclusão: {details.DeleteMarkerCount}\n" +
                         $"Tamanho: {details.TotalSize / 1024.0 / 1024.0:F2} MB\n\n" +
                         $"Detalhes:\n" + string.Join("\n", details.Details);
            
           showInspectionModal = true;
        }
    }
    
    private void CloseInspectionModal()
    {
        showInspectionModal = false;
    }

    private async Task DownloadFile(B2FileItem item)
    {
        var url = GetFilePreviewUrl(item.Key);
        await JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task DeleteFile(B2FileItem item)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Deseja realmente excluir o arquivo \"{CleanName(item.Name)}\"?");
        if (confirmed)
        {
            var success = await ProductService.DeleteB2FileAsync(item.Key);
            if (success)
            {
                statusMessage = $"Arquivo \"{CleanName(item.Name)}\" excluído com sucesso.";
                isStatusError = false;
                await LoadFiles();
            }
            else
            {
                statusMessage = $"Erro ao excluir o arquivo \"{CleanName(item.Name)}\".";
                isStatusError = true;
                StateHasChanged();
            }
        }
    }
}
