@page "/admin/orders"
@using BlazorClient.Core.Interfaces
@using BlazorClient.Models
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@inject IOrderService OrderService
@inject ILocalizationService L
@inject ISnackbar Snackbar

<PageTitle>Pedidos | IdealCreative</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="orders-page py-6 py-lg-8">
    <div class="orders-heading mb-6">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary" Class="fw-bold">OPERAÇÃO</MudText>
            <MudText Typo="Typo.h3" Class="fw-bold">Pedidos</MudText>
            <MudText Typo="Typo.body1" Class="text-muted mt-1">Consulte vendas, acompanhe pagamentos e atualize o andamento.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonSearch" Href="/admin/users" Class="rounded-pill px-5">Nova compra manual</MudButton>
    </div>

    <MudPaper Class="orders-panel rounded-xl mb-4 pa-4" Elevation="0">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="7">
                <MudTextField @bind-Value="search" Immediate="true" Placeholder="Buscar por pedido, cliente ou e-mail" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="5">
                <MudSelect T="string" Value="statusFilter" ValueChanged="ChangeStatusFilter" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@string.Empty">Todos os status</MudSelectItem>
                    @foreach (var status in AllStatuses)
                    {
                        <MudSelectItem Value="@status">@StatusLabel(status)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="orders-panel rounded-xl overflow-hidden" Elevation="0">
        @if (isLoading)
        {
            <div class="pa-8"><MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" /></div>
        }
        else if (FilteredOrders.Count == 0)
        {
            <div class="pa-12 text-center">
                <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Size="Size.Large" Class="text-muted mb-3" />
                <MudText Typo="Typo.h6">Nenhum pedido encontrado</MudText>
                <MudText Typo="Typo.body2" Class="text-muted">Altere os filtros ou aguarde uma nova venda.</MudText>
            </div>
        }
        else
        {
            <div class="orders-desktop table-responsive">
                <table class="table align-middle mb-0 orders-table">
                    <thead><tr><th>Pedido</th><th>Cliente</th><th>Data</th><th>Itens</th><th>Status</th><th class="text-end">Total</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var order in FilteredOrders)
                        {
                            <tr>
                                <td><strong>#@ShortId(order.Id)</strong><small>@PaymentLabel(order)</small></td>
                                <td><strong>@(order.CustomerName ?? "Cliente")</strong><small>@(order.CustomerEmail ?? order.UserId)</small></td>
                                <td>@order.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy")<small>@order.CreatedAt?.ToLocalTime().ToString("HH:mm")</small></td>
                                <td>@order.Items.Sum(item => item.Quantity)</td>
                                <td><MudChip T="string" Size="Size.Small" Color="@StatusColor(order.Status)" Variant="Variant.Outlined">@StatusLabel(order.Status)</MudChip></td>
                                <td class="text-end fw-bold">@L.FormatCurrency((decimal)order.Total)</td>
                                <td class="text-end"><MudIconButton Icon="@Icons.Material.Outlined.Visibility" Color="Color.Primary" OnClick="() => OpenOrder(order)" aria-label="Ver pedido" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="orders-mobile">
                @foreach (var order in FilteredOrders)
                {
                    <button type="button" class="order-mobile-card" @onclick="() => OpenOrder(order)">
                        <span class="d-flex justify-space-between align-center"><strong>#@ShortId(order.Id)</strong><MudChip T="string" Size="Size.Small" Color="@StatusColor(order.Status)" Variant="Variant.Outlined">@StatusLabel(order.Status)</MudChip></span>
                        <span class="order-customer">@(order.CustomerName ?? order.CustomerEmail ?? "Cliente")</span>
                        <span class="d-flex justify-space-between text-muted"><small>@order.CreatedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small><strong>@L.FormatCurrency((decimal)order.Total)</strong></span>
                    </button>
                }
            </div>

            <MudDivider />
            <div class="pagination-bar pa-4">
                <MudText Typo="Typo.body2" Class="text-muted">@pagination.TotalItems pedido(s)</MudText>
                <MudPagination Count="@pagination.TotalPages" Selected="@pagination.CurrentPage" SelectedChanged="ChangePage" Color="Color.Primary" Size="Size.Small" />
            </div>
        }
    </MudPaper>
</MudContainer>

@if (selectedOrder is not null)
{
    <div class="order-drawer-backdrop" @onclick="CloseOrder"></div>
    <aside class="order-drawer" role="dialog" aria-modal="true" aria-label="Detalhes do pedido">
        <header class="drawer-heading">
            <div><MudText Typo="Typo.overline" Color="Color.Primary">PEDIDO</MudText><MudText Typo="Typo.h5" Class="fw-bold">#@ShortId(selectedOrder.Id)</MudText></div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="CloseOrder" aria-label="Fechar" />
        </header>
        <div class="drawer-content">
            <div class="drawer-summary">
                <span><small>Status</small><MudChip T="string" Size="Size.Small" Color="@StatusColor(selectedOrder.Status)" Variant="Variant.Outlined">@StatusLabel(selectedOrder.Status)</MudChip></span>
                <span><small>Total</small><strong>@L.FormatCurrency((decimal)selectedOrder.Total)</strong></span>
            </div>

            <section><h3>Cliente</h3><p><strong>@(selectedOrder.CustomerName ?? "Cliente")</strong><br />@selectedOrder.CustomerEmail<br />@selectedOrder.CustomerPhone</p></section>
            @if (!string.IsNullOrWhiteSpace(selectedOrder.ShippingAddress) || !string.IsNullOrWhiteSpace(selectedOrder.ZipCode))
            {
                <section><h3>Entrega</h3><p>@selectedOrder.ShippingAddress<br />CEP @selectedOrder.ZipCode</p></section>
            }
            <section>
                <h3>Itens</h3>
                @foreach (var item in selectedOrder.Items)
                {
                    <div class="drawer-item">
                        <div class="drawer-thumb">@if (!string.IsNullOrWhiteSpace(item.ProductImage)) { <img src="@item.ProductImage" alt="" /> } else { <MudIcon Icon="@Icons.Material.Outlined.Inventory2" /> }</div>
                        <span><strong>@item.ProductTitle</strong><small>@item.Quantity × @L.FormatCurrency((decimal)item.Price) @(item.IsDigital ? "· Digital" : "")</small></span>
                        <strong>@L.FormatCurrency((decimal)item.TotalPrice)</strong>
                    </div>
                }
                <div class="totals"><span>Subtotal <strong>@L.FormatCurrency((decimal)selectedOrder.SubTotal)</strong></span>@if (selectedOrder.DiscountAmount > 0) { <span>Desconto <strong>-@L.FormatCurrency((decimal)selectedOrder.DiscountAmount)</strong></span> }<span class="total-row">Total <strong>@L.FormatCurrency((decimal)selectedOrder.Total)</strong></span></div>
            </section>
            <section><h3>Pagamento</h3><p>@PaymentLabel(selectedOrder)@if (selectedOrder.PaidAt.HasValue) { <br /><span>Confirmado em @selectedOrder.PaidAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span> }</p></section>

            @if (NextStatuses(selectedOrder.Status).Count > 0)
            {
                <section>
                    <h3>Atualizar andamento</h3>
                    <MudSelect T="string" @bind-Value="nextStatus" Label="Novo status" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var status in NextStatuses(selectedOrder.Status)) { <MudSelectItem Value="@status">@StatusLabel(status)</MudSelectItem> }
                    </MudSelect>
                    <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(isSaving || string.IsNullOrWhiteSpace(nextStatus))" OnClick="SaveStatus" Class="mt-3 rounded-pill">@(isSaving ? "Salvando..." : "Atualizar status")</MudButton>
                </section>
            }

            @if (!IsPaidStatus(selectedOrder.Status))
            {
                <MudButton FullWidth="true" Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" Disabled="@isSaving" OnClick="DeleteSelected">Excluir pedido não pago</MudButton>
            }
        </div>
    </aside>
}

@code {
    private static readonly string[] AllStatuses = ["Pending", "AwaitingPayment", "Paid", "Processing", "Shipped", "Delivered", "Cancelled"];
    private List<Order> orders = [];
    private PaginationData pagination = new() { CurrentPage = 1, PageSize = 25, TotalPages = 1 };
    private string search = string.Empty;
    private string statusFilter = string.Empty;
    private bool isLoading = true;
    private bool isSaving;
    private Order? selectedOrder;
    private string? nextStatus;

    private List<Order> FilteredOrders => orders.Where(order => string.IsNullOrWhiteSpace(search) || order.Id.Contains(search, StringComparison.OrdinalIgnoreCase) || (order.CustomerName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) || (order.CustomerEmail?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();

    protected override Task OnInitializedAsync() => LoadOrders(1);
    private async Task LoadOrders(int page)
    {
        isLoading = true;
        var response = await OrderService.GetAdminOrders(page, 25, statusFilter);
        orders = response.Items; pagination = response.Pagination; isLoading = false;
    }
    private async Task ChangePage(int page) => await LoadOrders(page);
    private async Task ChangeStatusFilter(string status) { statusFilter = status; await LoadOrders(1); }
    private void OpenOrder(Order order) { selectedOrder = order; nextStatus = NextStatuses(order.Status).FirstOrDefault(); }
    private void CloseOrder() { selectedOrder = null; nextStatus = null; }
    private async Task SaveStatus()
    {
        if (selectedOrder is null || string.IsNullOrWhiteSpace(nextStatus)) return;
        isSaving = true;
        try { await OrderService.UpdateOrderStatus(selectedOrder.Id, nextStatus); Snackbar.Add("Status atualizado com sucesso.", Severity.Success); CloseOrder(); await LoadOrders(pagination.CurrentPage); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { isSaving = false; }
    }
    private async Task DeleteSelected()
    {
        if (selectedOrder is null) return;
        isSaving = true;
        try { await OrderService.DeleteOrder(selectedOrder.Id); Snackbar.Add("Pedido excluído e estoque liberado.", Severity.Success); CloseOrder(); await LoadOrders(pagination.CurrentPage); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { isSaving = false; }
    }
    private static IReadOnlyList<string> NextStatuses(string? status) => status?.ToLowerInvariant() switch
    {
        "pending" => ["AwaitingPayment", "Paid", "Cancelled"],
        "awaitingpayment" => ["Paid", "Cancelled"],
        "paid" => ["Processing", "Shipped", "Delivered"],
        "processing" => ["Shipped", "Delivered"],
        "shipped" => ["Delivered"],
        _ => []
    };
    private static bool IsPaidStatus(string? status) => status?.ToLowerInvariant() is "paid" or "processing" or "shipped" or "delivered";
    private static string ShortId(string id) => id[..Math.Min(8, id.Length)].ToUpperInvariant();
    private static string PaymentLabel(Order order) => order.PaymentProvider ?? order.PaymentMethod ?? (order.Status == "Pending" ? "Pagamento não iniciado" : "Não informado");
    private static Color StatusColor(string? status) => status?.ToLowerInvariant() switch { "paid" or "delivered" => Color.Success, "processing" or "shipped" => Color.Info, "cancelled" => Color.Error, _ => Color.Warning };
    private static string StatusLabel(string? status) => status?.ToLowerInvariant() switch { "pending" => "Pendente", "awaitingpayment" => "Aguardando pagamento", "paid" => "Pago", "processing" => "Em produção", "shipped" => "Enviado", "delivered" => "Concluído", "cancelled" => "Cancelado", _ => status ?? "Pendente" };
}

<style>
    .orders-heading { display:flex; align-items:flex-end; justify-content:space-between; gap:1.5rem; }
    .orders-panel { background:var(--mud-palette-surface); border:1px solid var(--mud-palette-lines-default); box-shadow:0 14px 35px rgba(21,33,48,.06); }
    .orders-table th { padding:1rem 1.25rem; font-size:.75rem; color:var(--mud-palette-text-secondary); text-transform:uppercase; letter-spacing:.06em; border:0; }
    .orders-table td { padding:1rem 1.25rem; border-top:1px solid var(--mud-palette-lines-default); }
    .orders-table td small { display:block; color:var(--mud-palette-text-secondary); margin-top:.2rem; max-width:220px; overflow:hidden; text-overflow:ellipsis; }
    .orders-mobile { display:none; }
    .pagination-bar { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
    .order-drawer-backdrop { position:fixed; inset:0; z-index:1190; background:rgba(7,17,28,.48); backdrop-filter:blur(3px); }
    .order-drawer { position:fixed; z-index:1200; top:0; right:0; width:min(520px,100%); height:100dvh; background:var(--mud-palette-surface); box-shadow:-24px 0 60px rgba(0,0,0,.18); overflow:auto; animation:drawer-in .25s ease-out; }
    .drawer-heading { position:sticky; top:0; z-index:1; display:flex; justify-content:space-between; align-items:center; padding:1.25rem 1.5rem; background:color-mix(in srgb,var(--mud-palette-surface) 92%,transparent); backdrop-filter:blur(14px); border-bottom:1px solid var(--mud-palette-lines-default); }
    .drawer-content { padding:1.5rem; display:grid; gap:1.25rem; }
    .drawer-content section { padding:1.15rem; border:1px solid var(--mud-palette-lines-default); border-radius:18px; }
    .drawer-content h3 { font-size:.75rem; text-transform:uppercase; letter-spacing:.08em; color:var(--mud-palette-text-secondary); margin:0 0 .85rem; }
    .drawer-content p { margin:0; line-height:1.7; }
    .drawer-summary { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
    .drawer-summary > span { display:flex; flex-direction:column; gap:.45rem; padding:1rem; border-radius:16px; background:color-mix(in srgb,var(--mud-palette-primary) 6%,transparent); }
    .drawer-summary small { color:var(--mud-palette-text-secondary); }
    .drawer-item { display:grid; grid-template-columns:46px 1fr auto; align-items:center; gap:.8rem; padding:.65rem 0; }
    .drawer-thumb { width:46px; height:46px; display:grid; place-items:center; overflow:hidden; border-radius:12px; background:var(--mud-palette-background); }
    .drawer-thumb img { width:100%; height:100%; object-fit:cover; }
    .drawer-item span small { display:block; color:var(--mud-palette-text-secondary); }
    .totals { display:grid; gap:.55rem; margin-top:1rem; padding-top:1rem; border-top:1px solid var(--mud-palette-lines-default); }
    .totals span { display:flex; justify-content:space-between; }
    .total-row { font-size:1.1rem; }
    @@keyframes drawer-in { from { transform:translateX(100%); } }
    @@media (max-width:700px) { .orders-heading { align-items:stretch; flex-direction:column; } .orders-heading .mud-button-root { width:100%; } .orders-desktop { display:none; } .orders-mobile { display:grid; } .order-mobile-card { display:grid; gap:.75rem; padding:1rem; text-align:left; color:inherit; background:transparent; border:0; border-bottom:1px solid var(--mud-palette-lines-default); } .order-customer { font-weight:700; } .pagination-bar { align-items:flex-start; flex-direction:column; } }
</style>
