@using System.Text.Json.Serialization
@using BlazorClient.Core.Interfaces
@page "/admin/products/new"
@page "/admin/products/edit/{Id}"
@using BlazorClient.Models
@using BlazorClient.Core.Services
@using BlazorClient.Components
@inject IProductService ProductService
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ILocalizationService L
@inject ISnackbar Snackbar
@layout AdminLayout

<div class="admin-page-header ic-admin-page-heading">
    <div><span class="ic-admin-kicker">CATÁLOGO</span><h1>@(IsEdit ? "Editar produto" : "Novo produto")</h1><p>Organize informações, imagens, estoque e entrega do produto.</p></div>
    <button type="button" class="btn btn-outline-secondary" @onclick="NavigateBack">
        <i class="fa fa-arrow-left"></i> @L.Get("Admin.Common.Back")
    </button>
</div>

<section class="admin-section" style="background: transparent; padding: 0;">
    <div class="container">
        <div class="admin-container">
            <EditForm Model="@product" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row">
                    <!-- Image Upload Section -->
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <div class="card-body text-center">
                                <h5 class="card-title mb-3">@L.Get("Admin.ProductForm.MainImage")</h5>
                                
                                <div class="image-preview mb-3 position-relative">
                                    @if (!string.IsNullOrEmpty(product.ImageName))
                                    {
                                        <div class="position-relative">
                                            <img src="@product.ImageName" class="img-fluid rounded" style="max-height: 200px; object-fit: cover;" />
                                            <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2" @onclick="RemoveImage" title="@L.Get("Admin.ProductForm.RemoveImage")">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="bg-light p-4 rounded d-flex align-items-center justify-content-center" style="height: 200px;">
                                            <i class="fa fa-image fa-3x text-muted"></i>
                                        </div>
                                    }
                                </div>

                                @if (isUploading)
                                {
                                    <div class="mb-3">
                                        <div class="progress" style="height: 25px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated" 
                                                 role="progressbar" 
                                                 style="width: @(uploadProgress)%"
                                                 aria-valuenow="@uploadProgress" 
                                                 aria-valuemin="0" 
                                                 aria-valuemax="100">
                                                @uploadProgress%
                                            </div>
                                        </div>
                                        <small class="text-muted">@L.Get("Admin.ProductForm.UploadingImage")</small>
                                    </div>
                                }

                                <InputFile OnChange="HandleFileSelected" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif,.avif" disabled="@isUploading" />
                                <small class="text-muted d-block mt-2">@L.Get("Admin.ProductForm.ImageFormats")</small>
                                @if (!string.IsNullOrWhiteSpace(imageUploadError))
                                {
                                    <div class="alert alert-danger mt-3 mb-0 text-start" role="alert">@imageUploadError</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(imageUploadNotice))
                                {
                                    <div class="alert alert-success mt-3 mb-0 text-start" role="status">@imageUploadNotice</div>
                                }
                                
                                <!-- Imagens Adicionais -->
                                <hr class="my-4" />
                                <h6 class="card-title mb-3">@L.Get("Admin.ProductForm.AdditionalImages")</h6>
                                
                                @if (additionalImages.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mb-3 justify-content-center">
                                        @for (int i = 0; i < additionalImages.Count; i++)
                                        {
                                            var index = i;
                                            <div class="position-relative" style="width: 80px; height: 80px;">
                                                <img src="@additionalImages[index]" class="rounded" style="width: 80px; height: 80px; object-fit: cover;" />
                                                <button type="button" class="btn btn-danger btn-sm position-absolute top-0 end-0" 
                                                        style="padding: 2px 5px; font-size: 10px;" 
                                                        @onclick="() => RemoveAdditionalImage(index)" 
                                                        title="@L.Get("Admin.ProductForm.Remove")">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                                
                                @if (isUploadingAdditional)
                                {
                                    <div class="mb-3">
                                        <div class="progress" style="height: 20px;">
                                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" 
                                                 role="progressbar" 
                                                 style="width: @(additionalUploadProgress)%">
                                                @additionalUploadProgress%
                                            </div>
                                        </div>
                                        <small class="text-muted">@L.Get("Admin.ProductForm.UploadingAdditional")</small>
                                    </div>
                                }
                                
                                <InputFile OnChange="HandleAdditionalImageSelected" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif,.avif" disabled="@isUploadingAdditional" multiple />
                                <small class="text-muted d-block mt-2">@L.Get("Admin.ProductForm.AddExtraImages")</small>
                                @if (!string.IsNullOrWhiteSpace(additionalImageUploadError))
                                {
                                    <div class="alert alert-danger mt-3 mb-0 text-start" role="alert">@additionalImageUploadError</div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Product Details Section -->
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">@L.Get("Admin.Common.ProductNameLabel")</label>
                                        <InputText class="form-control" @bind-Value="product.Title" />
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">@L.Get("Admin.Common.PriceR$Label")</label>
                                        <InputNumber class="form-control" @bind-Value="product.Price" />
                                    </div>

                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">@L.Get("Admin.Common.Stock")</label>
                                        <InputNumber class="form-control" @bind-Value="product.Qty" />
                                    </div>
                                    
                                    @if (!product.IsDigital && !product.IsSubscription)
                                    {
                                        <div class="col-md-12 mb-3">
                                            <div class="card bg-light">
                                                <div class="card-body py-2">
                                                    <h6 class="card-title text-muted mb-3" style="font-size: 0.9rem; font-weight: 600;">
                                                        <i class="fa fa-truck"></i> @L.Get("Admin.ProductForm.ShippingDimensions")
                                                    </h6>
                                                    
                                                    @if (product.Height > 105 || product.Width > 105 || product.Length > 105 || product.Weight > 30)
                                                    {
                                                        <div class="alert alert-warning py-2 small mb-3">
                                                            <i class="fa fa-exclamation-triangle"></i> @L.Get("Product.DimensionLimitWarning")
                                                        </div>
                                                    }

                                                    <div class="row">
                                                        <div class="col-md-3 mb-2">
                                                            <label class="form-label small">@L.Get("Admin.Common.Weight") <span class="text-muted" style="font-size: 0.7rem;">@L.Get("Product.WeightLimitInfo")</span></label>
                                                            <InputNumber class="form-control form-control-sm" @bind-Value="product.Weight" step="0.1" />
                                                        </div>
                                                        <div class="col-md-3 mb-2">
                                                            <label class="form-label small">@L.Get("Admin.Common.Width") <span class="text-muted" style="font-size: 0.7rem;">@L.Get("Product.DimensionLimitInfo")</span></label>
                                                            <InputNumber class="form-control form-control-sm" @bind-Value="product.Width" />
                                                        </div>
                                                        <div class="col-md-3 mb-2">
                                                            <label class="form-label small">@L.Get("Admin.Common.Height") <span class="text-muted" style="font-size: 0.7rem;">@L.Get("Product.DimensionLimitInfo")</span></label>
                                                            <InputNumber class="form-control form-control-sm" @bind-Value="product.Height" />
                                                        </div>
                                                        <div class="col-md-3 mb-2">
                                                            <label class="form-label small">@L.Get("Admin.Common.Length") <span class="text-muted" style="font-size: 0.7rem;">@L.Get("Product.DimensionLimitInfo")</span></label>
                                                            <InputNumber class="form-control form-control-sm" @bind-Value="product.Length" />
                                                        </div>
                                                    </div>
                                                    <small class="text-muted" style="font-size: 0.75rem;">
                                                        @L.Get("Admin.ProductForm.ShippingNote")
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    <div class="col-md-12 mb-3">
                                        <div class="card border-secondary">
                                            <div class="card-header py-2 px-3 bg-light d-flex justify-content-between align-items-center" style="cursor:pointer;" @onclick="() => showFiscalData = !showFiscalData">
                                                <span style="font-size: 0.9rem; font-weight: 600;" class="text-muted">
                                                    <i class="fa fa-file-text-o me-1"></i> @L.Get("Admin.ProductForm.FiscalData")
                                                    <span class="badge bg-secondary ms-2" style="font-size: 0.65rem; font-weight: 400;">Opcional</span>
                                                </span>
                                                <i class="fa @(showFiscalData ? "fa-chevron-up" : "fa-chevron-down") text-muted" style="font-size: 0.8rem;"></i>
                                            </div>
                                            @if (showFiscalData)
                                            {
                                                <div class="card-body py-2">
                                                    <div class="row">
                                                        <div class="col-md-4 mb-2">
                                                            <label class="form-label small">@L.Get("Admin.ProductForm.NcmLabel")</label>
                                                            <InputText class="form-control form-control-sm" @bind-Value="product.Ncm" placeholder="00000000" />
                                                        </div>
                                                        <div class="col-md-4 mb-2">
                                                            <label class="form-label small">@L.Get("Admin.ProductForm.CestLabel")</label>
                                                            <InputText class="form-control form-control-sm" @bind-Value="product.Cest" />
                                                        </div>
                                                        <div class="col-md-4 mb-2">
                                                            <label class="form-label small">@L.Get("Admin.Common.Origin")</label>
                                                            <InputSelect class="form-select form-select-sm" @bind-Value="product.Origem">
                                                                <option value="0">@L.Get("Admin.ProductForm.OriginNational")</option>
                                                                <option value="1">@L.Get("Admin.ProductForm.OriginForeignDirect")</option>
                                                                <option value="2">@L.Get("Admin.ProductForm.OriginForeignInternal")</option>
                                                            </InputSelect>
                                                        </div>
                                                        <div class="col-md-6 mb-2">
                                                            <label class="form-label small">@L.Get("Admin.ProductForm.GtinLabel")</label>
                                                            <InputText class="form-control form-control-sm" @bind-Value="product.Gtin" placeholder="SEM GTIN" />
                                                        </div>
                                                        <div class="col-md-6 mb-2">
                                                            <label class="form-label small">@L.Get("Admin.Common.CommercialUnit")</label>
                                                            <InputText class="form-control form-control-sm" @bind-Value="product.Unidade" placeholder="@L.Get("Admin.ProductForm.UnitPlaceholder")" />
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <div class="col-md-12 mb-3">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label class="form-label mb-0">@L.Get("Admin.Common.Category")</label>
                                            <div>
                                                <button type="button" class="btn btn-sm btn-outline-primary me-2" 
                                                        @onclick="EditSelectedCategory" 
                                                        disabled="@string.IsNullOrEmpty(product.CategoryId)"
                                                        title="@L.Get("Admin.Common.Edit")">
                                                    <i class="fa fa-pencil"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-success" @onclick="() => showCategoryModal = true">
                                                    <i class="fa fa-plus"></i> @L.Get("Admin.Common.NewCategory")
                                                </button>
                                            </div>
                                        </div>
                                        <InputSelect class="form-control" @bind-Value="product.CategoryId">
                                            <option value="">@L.Get("Admin.ProductForm.SelectCategory")</option>
                                            @foreach (var category in categories)
                                            {
                                                <option value="@category.Id">@category.GetTranslatedTitle(L.CurrentLanguage)</option>
                                            }
                                        </InputSelect>
                                         </div>

                                     <div class="col-md-12 mb-4">

                                        <MudTabs Elevation="0" Outlined="true" ApplyEffectsToContainer="false" Color="Color.Primary" TabHeaderClass="product-admin-tabs" Rounded="true" PanelClass="pt-4 px-1" KeepPanelsAlive="true">
                                            @* Base Language (Portuguese) *@
                                            <MudTabPanel Text="🇧🇷 PT-BR (Base)">
                                                <div class="mb-0">
                                                    <div class="mb-3">
                                                        <label class="form-label" style="font-weight: 500;">@L.Get("Admin.Common.ProductNameLabel")</label>
                                                        <InputText class="form-control" @bind-Value="product.Title" placeholder="Título do produto em Português" />
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label" style="font-weight: 500;">@L.Get("Admin.Common.ShortDescription")</label>
                                                        <InputTextArea class="form-control" @bind-Value="product.Description" rows="2" placeholder="Resumo em Português" />
                                                    </div>

                                                    <div class="mb-0">
                                                        <label class="form-label" style="font-weight: 500;">@L.Get("Admin.Common.FullDescription")</label>
                                                        <div class="quill-editor-wrapper">
                                                            <BlazoredTextEditor @ref="@QuillHtml" Placeholder="@L.Get("Admin.ProductForm.DescriptionPlaceholder")">
                                                                <ToolbarContent>
                                                                    <select class="ql-header">
                                                                        <option selected></option>
                                                                        <option value="1"></option>
                                                                        <option value="2"></option>
                                                                        <option value="3"></option>
                                                                    </select>
                                                                    <span class="ql-formats">
                                                                        <button class="ql-bold"></button>
                                                                        <button class="ql-italic"></button>
                                                                        <button class="ql-underline"></button>
                                                                        <button class="ql-strike"></button>
                                                                    </span>
                                                                    <span class="ql-formats">
                                                                        <select class="ql-color"></select>
                                                                        <select class="ql-background"></select>
                                                                    </span>
                                                                    <span class="ql-formats">
                                                                        <button class="ql-list" value="ordered"></button>
                                                                        <button class="ql-list" value="bullet"></button>
                                                                    </span>
                                                                    <span class="ql-formats">
                                                                        <button class="ql-link"></button>
                                                                        <button class="ql-image"></button>
                                                                    </span>
                                                                    <span class="ql-formats">
                                                                        <button class="ql-clean"></button>
                                                                    </span>
                                                                </ToolbarContent>
                                                                <EditorContent>
                                                                    @((MarkupString)(product.FullDesc ?? ""))
                                                                </EditorContent>
                                                            </BlazoredTextEditor>
                                                        </div>
                                                        <small class="text-muted">@L.Get("Admin.ProductForm.ToolbarTip")</small>
                                                    </div>
                                                </div>
                                            </MudTabPanel>

                                            @* Additional Languages *@
                                            @foreach (var lang in SupportedLanguagesList.Where(l => l.Code != "pt-BR"))
                                            {
                                                var langCode = lang.Code;
                                                var trans = GetTranslationModel(langCode);
                                                <MudTabPanel Text="@($"{lang.Flag} {lang.Code}")" ToolTip="@lang.Name">
                                                    <div class="alert alert-info py-2 small mb-3">
                                                        <i class="fa fa-info-circle"></i> @(string.Format(L.Get("Admin.ProductForm.ManualEntryHint"), lang.Name))
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label" style="font-weight: 500;">@L.Get("Admin.Common.ProductNameLabel") (@lang.Code)</label>
                                                        <InputText class="form-control" @bind-Value="trans.Title" placeholder="@($"Title in {lang.Name}")" />
                                                        <div class="d-flex justify-content-end mt-1">
                                                            <button type="button" class="btn btn-link btn-sm p-0 m-0" style="font-size: 0.75rem;" 
                                                                    @onclick="() => CopyTitleToTranslation(langCode)">
                                                                <i class="fa fa-copy"></i> @L.Get("Admin.ProductForm.CopyFromBase")
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <div class="mb-3">
                                                        <label class="form-label" style="font-weight: 500;">@L.Get("Admin.Common.ShortDescription") (@lang.Code)</label>
                                                        <InputTextArea class="form-control" @bind-Value="trans.Description" rows="2" placeholder="@($"Short desc in {lang.Name}")" />
                                                        <div class="d-flex justify-content-end mt-1">
                                                            <button type="button" class="btn btn-link btn-sm p-0 m-0" style="font-size: 0.75rem;" 
                                                                    @onclick="() => CopyDescriptionToTranslation(langCode)">
                                                                <i class="fa fa-copy"></i> @L.Get("Admin.ProductForm.CopyFromBase")
                                                            </button>
                                                        </div>
                                                    </div>

                                                    <div class="mb-0">
                                                        <label class="form-label" style="font-weight: 500;">@L.Get("Admin.Common.FullDescription") (HTML - @lang.Code)</label>
                                                        <InputTextArea class="form-control" @bind-Value="trans.FullDesc" rows="8" style="font-family: monospace; font-size: 0.85rem;" placeholder="Insira o HTML traduzido ou texto puro aqui." />
                                                        <div class="d-flex justify-content-end mt-1">
                                                            <button type="button" class="btn btn-link btn-sm p-0 m-0" style="font-size: 0.75rem;" 
                                                                    @onclick="() => CopyRichToTranslation(langCode)">
                                                                <i class="fa fa-copy"></i> @L.Get("Admin.ProductForm.CopyFromBase")
                                                            </button>
                                                        </div>
                                                    </div>
                                                </MudTabPanel>
                                            }
                                            
                                        </MudTabs>
                                    </div>
                                    
                                    <div class="col-md-12 mb-3">
                                        <label class="form-label">@L.Get("Admin.Common.VideoUrl")</label>
                                        <InputText class="form-control" @bind-Value="product.VideoUrl" />
                                    </div>

                                    <div class="col-md-12 mb-3">                                        <TagPicker @bind-Value="product.Tags" />
                                    </div>
                                    
                                    <div class="col-md-12 mb-3">
                                        <div class="form-check form-switch">
                                            <InputCheckbox class="form-check-input" @bind-Value="product.IsDigital" id="isDigital" />
                                            <label class="form-check-label" for="isDigital">@L.Get("Admin.Common.ProductDigital")</label>
                                        </div>
                                    </div>

                                    @* Toggle para anexar arquivo mesmo em produtos físicos *@
                                    @if (!product.IsDigital)
                                    {
                                        <div class="col-md-12 mb-3">
                                            <div class="form-check form-switch">
                                                <InputCheckbox class="form-check-input" @bind-Value="showDigitalFileSection" id="attachDigitalFile" />
                                                <label class="form-check-label" for="attachDigitalFile">
                                                    <i class="fa fa-paperclip"></i> @L.Get("Admin.ProductForm.AttachDigitalFile")
                                                </label>
                                            </div>
                                            <small class="text-muted">@L.Get("Admin.ProductForm.DigitalFileNote")</small>
                                        </div>
                                    }

                                    @if (product.IsDigital || showDigitalFileSection || !string.IsNullOrEmpty(product.DigitalFilePath))
                                    {
                                        <div class="col-md-12 mb-3">
                                            <div class="card bg-light">
                                                <div class="card-body ic-digital-file-card">
                                                    <h6 class="card-title">
                                                        <i class="fa fa-file-archive-o"></i> @L.Get("Admin.ProductForm.DigitalFileZip")
                                                    </h6>
                                                    
                                                    @if (!string.IsNullOrEmpty(product.DigitalFilePath))
                                                    {
                                                        <div class="ic-digital-file-summary mb-3" role="status">
                                                            <div class="ic-digital-file-info">
                                                                <i class="fa fa-check-circle"></i>
                                                                <strong>@L.Get("Admin.ProductForm.FileUploaded")</strong> @GetDigitalFileName()
                                                            </div>
                                                            <div class="ic-digital-file-actions">
                                                                @if (IsEdit)
                                                                {
                                                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="DownloadDigitalFile" disabled="@isDownloadingDigital">
                                                                        <i class="fa fa-download"></i> @(isDownloadingDigital ? "Preparando..." : "Baixar")
                                                                    </button>
                                                                }
                                                                <button type="button" class="btn btn-sm btn-info text-white" @onclick="InspectFile" title="Verificar integridade do backup">
                                                                    <i class="fa fa-search"></i> @L.Get("Admin.ProductForm.VerifyBackup")
                                                                </button>
                                                                <button type="button" class="btn btn-sm btn-danger" @onclick="RemoveDigitalFile" disabled="@isUploadingDigital">
                                                                    <i class="fa fa-trash"></i> @L.Get("Admin.ProductForm.Remove")
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <small class="text-muted">@L.Get("Admin.ProductForm.ReplaceFileNote")</small>
                                                    }
                                                    else
                                                    {
                                                        @if (isUploadingDigital)
                                                        {
                                                            <div class="mb-3">
                                                                <div class="progress" style="height: 25px;">
                                                                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" 
                                                                         role="progressbar" 
                                                                         style="width: @(digitalUploadProgress)%"
                                                                         aria-valuenow="@digitalUploadProgress" 
                                                                         aria-valuemin="0" 
                                                                         aria-valuemax="100">
                                                                        @digitalUploadProgress%
                                                                    </div>
                                                                </div>
                                                                <small class="text-muted">@L.Get("Admin.ProductForm.UploadingFile")</small>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <input @ref="digitalFileInputRef" @onchange="HandleDigitalFileSelectedDirect" type="file" class="form-control" accept=".zip,.rar,.7z,.stl,.dxf,.cdr,.pdf,.svg,.obj,.3mf" />
                                                            <small class="text-muted d-block mt-2">Formatos aceitos: .ZIP, .RAR, .7Z, .STL, .DXF, .CDR, .PDF, .SVG, .OBJ, .3MF (máx. 250MB)</small>
                                                            @if (!string.IsNullOrEmpty(digitalFileError))
                                                            {
                                                                <div class="alert alert-danger mt-2">@digitalFileError</div>
                                                            }
                                                        }
                                                    }


                                                    </div>
                                                </div>
                                            </div>
                                        }

                                </div>



                                <div class="mt-3">
                                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                                            <span> @L.Get("Admin.ProductForm.Saving")</span>
                                        }
                                        else
                                        {
                                            <i class="fa fa-save"></i>
                                            <span> @L.Get("Admin.ProductForm.SaveProduct")</span>
                                        }
                                    </button>
                                </div>
                                
                                @if (showSuccessMessage)
                                {
                                    <div class="alert alert-success mt-3 shadow-sm border-success">
                                        <div class="d-flex align-items-center">
                                            <i class="fa fa-check-circle fa-2x me-3"></i>
                                            <div>
                                                <h5 class="alert-heading mb-1">@L.Get("Admin.ProductForm.SuccessTitle")</h5>
                                                <p class="mb-0">@L.Get("Admin.ProductForm.SuccessMessage")</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>

            <!-- Modal para criar nova categoria -->
            @if (showCategoryModal)
            {
                <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title">@L.Get("Admin.ProductForm.ManageCategories")</h5>
                                <button type="button" class="btn-close" @onclick="() => showCategoryModal = false"></button>
                            </div>
                            <div class="modal-body">

                                <div class="mb-4">
                                    <h6 class="border-bottom pb-2">@L.Get("Admin.ProductForm.ExistingCategories")</h6>
                                    
                                    <!-- Search and Pagination Controls -->
                                    <div class="row g-2 mb-2">
                                        <div class="col-8">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                                                <input type="text" class="form-control" placeholder="@L.Get("Admin.ProductForm.SearchPlaceholder")" 
                                                       @bind="categorySearchTerm" @bind:event="oninput" />
                                            </div>
                                        </div>
                                        <div class="col-4 text-end">
                                            <small class="text-muted">
                                                @((categoryCurrentPage - 1) * categoryPageSize + 1) - 
                                                @(Math.Min(categoryCurrentPage * categoryPageSize, FilteredCategories.Count)) 
                                                de @FilteredCategories.Count
                                            </small>
                                        </div>
                                    </div>

                                    @if(!FilteredCategories.Any())
                                    {
                                        <p class="text-muted text-center py-3">@L.Get("Admin.ProductForm.NoCategoriesFound")</p>
                                    }
                                    else
                                    {
                                        <div class="list-group mb-2" style="max-height: 250px; overflow-y: auto;">
                                            @foreach (var category in PaginatedCategories)
                                            {
                                                var cat = category;
                                                <div @key="cat.Id" class="list-group-item d-flex justify-content-between align-items-center py-2">
                                                    <div class="d-flex align-items-center">
                                                        <span>@cat.Title</span>
                                                    </div>
                                                    <div class="d-flex gap-1">
                                                        @if (pendingDeleteCategoryId == cat.Id)
                                                        {
                                                            <div class="btn-group">
                                                                <button type="button" class="btn btn-sm btn-danger" @onclick="ConfirmDeleteCategory">Sim</button>
                                                                <button type="button" class="btn btn-sm btn-secondary" @onclick="CancelDeleteCategory">Não</button>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => StartEditCategory(cat)" title="Editar">
                                                                <i class="fa fa-pencil"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => { pendingDeleteCategoryId = cat.Id; }" title="Excluir">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        
                                        <!-- Pagination Buttons -->
                                        @if(TotalCategoryPages > 1)
                                        {
                                            <div class="d-flex justify-content-center gap-2">
                                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                                        disabled="@(categoryCurrentPage == 1)"
                                                        @onclick="() => categoryCurrentPage--">
                                                    <i class="fa fa-chevron-left"></i>
                                                </button>
                                                <span class="align-self-center small">@L.Get("Admin.ProductForm.PageXofY", categoryCurrentPage.ToString(), TotalCategoryPages.ToString())</span>
                                                <button type="button" class="btn btn-sm btn-outline-secondary" 
                                                        disabled="@(categoryCurrentPage >= TotalCategoryPages)"
                                                        @onclick="() => categoryCurrentPage++">
                                                    <i class="fa fa-chevron-right"></i>
                                                </button>
                                            </div>
                                        }
                                    }
                                </div>
                                
                                <h6 class="border-bottom pb-2 mt-3">@(isEditingCategory ? "Editar Categoria" : L.Get("Admin.Common.NewCategory"))</h6>
                                
                                <div class="mb-3">
                                    <label class="form-label small">@L.Get("Admin.Common.CategoryName") (PT-BR)</label>
                                    <InputText class="form-control" @bind-Value="categoryDto.Title" placeholder="@L.Get("Admin.ProductForm.CategoryPlaceholder")" />
                                </div>

                                <MudTabs Elevation="0" Outlined="true" ApplyEffectsToContainer="false" Color="Color.Primary" Rounded="true" PanelClass="pt-3 px-1" MinimumTabWidth="60px">
                                    @foreach (var lang in SupportedLanguagesList.Where(l => l.Code != "pt-BR"))
                                    {
                                        var langCode = lang.Code;
                                        var trans = GetCategoryTranslationModel(langCode);
                                        <MudTabPanel Text="@($"{lang.Flag} {lang.Code}")">
                                            <div class="mb-2">
                                                <label class="form-label small">Título (@lang.Code)</label>
                                                <InputText class="form-control form-control-sm" @bind-Value="trans.Title" placeholder="@($"Título em {lang.Name}")" />
                                            </div>
                                        </MudTabPanel>
                                    }
                                </MudTabs>

                                <div class="mb-3 mt-3">
                                    <label class="form-label small">Prioridade</label>
                                    <InputNumber class="form-control" @bind-Value="categoryDto.Priority" />
                                </div>
                                
                                @if (!string.IsNullOrEmpty(categoryErrorMessage))
                                {
                                    <div class="alert alert-danger py-2 small mb-3">@categoryErrorMessage</div>
                                }
                                
                                <div class="d-flex justify-content-end gap-2 mt-4">
                                    <button type="button" class="btn btn-secondary" @onclick="() => { showCategoryModal = false; CancelEditCategory(); }">@L.Get("Admin.ProductForm.Close")</button>
                                    <button type="button" class="btn btn-primary" @onclick="HandleSaveCategory" disabled="@isSavingCategory">
                                        @if (isSavingCategory)
                                        {
                                            <span class="spinner-border spinner-border-sm"></span>
                                            <span> @L.Get("Admin.ProductForm.Saving")</span>
                                        }
                                        else
                                        {
                                            <i class="fa fa-save"></i>
                                            <span> @(isEditingCategory ? "Salvar" : L.Get("Admin.ProductForm.Create"))</span>
                                        }
                                    </button>
                                    @if (isEditingCategory)
                                    {
                                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEditCategory">Cancelar Edição</button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

