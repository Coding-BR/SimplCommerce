    private async Task CopyRichToTranslation(string langCode)
    {
        if (QuillHtml == null) return;
        var html = await QuillHtml.GetHTML();
        var model = GetTranslationModel(langCode);
        model.FullDesc = html;
        StateHasChanged();
        Snackbar.Add(string.Format(L.Get("Admin.ProductForm.DescriptionCopied"), langCode), Severity.Info);
    }

    private void CopyTitleToTranslation(string langCode)
    {
        if (string.IsNullOrWhiteSpace(product.Title)) return;
        var model = GetTranslationModel(langCode);
        model.Title = product.Title;
        StateHasChanged();
        Snackbar.Add($"Título copiado para {langCode}", Severity.Info);
    }

    private void CopyDescriptionToTranslation(string langCode)
    {
        if (string.IsNullOrWhiteSpace(product.Description)) return;
        var model = GetTranslationModel(langCode);
        model.Description = product.Description;
        StateHasChanged();
        Snackbar.Add($"Descrição curta copiada para {langCode}", Severity.Info);
    }
