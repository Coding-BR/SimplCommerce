@code {
    [Parameter]
    public string? Id { get; set; }

    [SupplyParameterFromQuery]
    public int? ReturnPage { get; set; }

    private void NavigateBack()
    {
        if (ReturnPage.HasValue && ReturnPage > 1)
        {
            Navigation.NavigateTo($"/admin/products?page={ReturnPage}");
        }
        else
        {
            Navigation.NavigateTo("/admin/products");
        }
    }

    private bool IsEdit => !string.IsNullOrEmpty(Id);
    private CreateProductDto product = new();
    private List<Category> categories = new();
    private bool isSubmitting = false;
    private bool isDownloadingDigital = false;
    private bool showSuccessMessage = false;

    // Multi-language state
    private List<LanguageInfo> SupportedLanguagesList = LocalizationService.SupportedLanguages.Values.ToList();
    private Dictionary<string, ProductTranslation> translationModels = new();
    
    // Upload progress tracking
    private bool isUploading = false;
    private string imageUploadError = string.Empty;
    private string imageUploadNotice = string.Empty;
    private string? pendingMainImageDeletion;
    private int uploadProgress = 0;
    
    // Digital file upload tracking
    private bool isUploadingDigital = false;
    private bool showFiscalData = false;

    private int digitalUploadProgress = 0;
    private string digitalFileError = string.Empty;
    
    // Category management
    private bool showCategoryModal = false;
    private CreateCategoryDto categoryDto = new();
    private bool isSavingCategory = false;
    private bool isEditingCategory = false;
    private string? editingCategoryId = null;
    private Dictionary<string, CategoryTranslation> categoryTranslationModels = new();
    private string categoryErrorMessage = string.Empty;
    private string? pendingDeleteCategoryId = null; 
    
    // Additional images
    private List<string> additionalImages = new();
    private bool isUploadingAdditional = false;
    private string additionalImageUploadError = string.Empty;
    private int additionalUploadProgress = 0;

    // Toggle to show digital file section for non-digital products
    private bool showDigitalFileSection = false;

    // Blazored Text Editor reference
    private BlazoredTextEditor? QuillHtml;

    // Pagination and Search state
    private string categorySearchTerm = "";
    private int categoryCurrentPage = 1;
    private int categoryPageSize = 5;

    private List<Category> FilteredCategories => categories
        .Where(c => string.IsNullOrEmpty(categorySearchTerm) || 
                   c.Title.Contains(categorySearchTerm, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<Category> PaginatedCategories => FilteredCategories
        .Skip((categoryCurrentPage - 1) * categoryPageSize)
        .Take(categoryPageSize)
        .ToList();

    private int TotalCategoryPages => (int)Math.Ceiling((double)FilteredCategories.Count / categoryPageSize);

    protected override async Task OnInitializedAsync()
    {
        categories = await ProductService.GetCategoriesAsync();

        if (IsEdit)
        {
            // Use Admin method to bypass cache and ensure fresh data
            var existingProduct = await ProductService.GetAdminProductAsync(Id!);
            if (existingProduct != null)
            {
                product = new CreateProductDto
                {
                    Title = existingProduct.Title,
                    Price = existingProduct.Price,
                    Description = existingProduct.Description,
                    FullDesc = existingProduct.FullDesc,

                    Qty = existingProduct.Qty,
                    ImageName = existingProduct.ImageName,
                    Images = existingProduct.Images,
                    CategoryId = existingProduct.CategoryId,
                    VideoUrl = existingProduct.VideoUrl,
                    DownloadUrl = existingProduct.DownloadUrl,
                    Tags = existingProduct.Tags,
                    IsSubscription = existingProduct.IsSubscription,
                    PayPalPlanId = existingProduct.PayPalPlanId,
                    RecurringInterval = existingProduct.RecurringInterval,
                    DurationMonths = existingProduct.DurationMonths > 0 ? existingProduct.DurationMonths : 1,
                    IsDigital = existingProduct.IsDigital,
                    DigitalFilePath = existingProduct.DigitalFilePath,
                    HideDigitalFromCustomer = existingProduct.HideDigitalFromCustomer,
                    TelegramGroupId = existingProduct.TelegramGroupId,
                    
                    // Shipping Dimensions
                    Width = existingProduct.Width,
                    Height = existingProduct.Height,
                    Length = existingProduct.Length,
                    Weight = existingProduct.Weight,

                    // Fiscal Fields
                    Ncm = existingProduct.Ncm,
                    Cest = existingProduct.Cest,
                    Origem = existingProduct.Origem,
                    Gtin = existingProduct.Gtin,
                    Unidade = existingProduct.Unidade ?? "UN",
                    Translations = existingProduct.Translations,
                    SkipTranslation = existingProduct.SkipTranslation
                };
                
                // Initialize translation models from existing product translations
                if (existingProduct.Translations != null)
                {
                    foreach (var kv in existingProduct.Translations)
                    {
                        translationModels[kv.Key] = new ProductTranslation
                        {
                            Title = kv.Value.Title,
                            Description = kv.Value.Description,
                            FullDesc = kv.Value.FullDesc,
                            ManualOverride = kv.Value.ManualOverride
                        };
                    }
                }
                
                // Load additional images
                if (existingProduct.Images != null && existingProduct.Images.Count > 0)
                {
                    additionalImages = new List<string>(existingProduct.Images);
                }
            }
        }
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        imageUploadError = string.Empty;
        imageUploadNotice = string.Empty;
        var file = e.File;
        if (file != null)
        {
            isUploading = true;
            uploadProgress = 0;
            StateHasChanged();
            
            // Optimize image: Resize to max 1200x1200 and convert to WebP
            IBrowserFile uploadFile = file;
            try 
            {
                uploadFile = await file.RequestImageFileAsync("image/webp", 1200, 1200);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Image optimization failed, using original: {ex.Message}");
            }

            try
            {
                var url = await ProductService.UploadProductImageAsync(uploadFile, (progress) =>
                {
                    uploadProgress = progress;
                    InvokeAsync(StateHasChanged);
                });
                if (!string.IsNullOrWhiteSpace(product.ImageName) && !string.Equals(product.ImageName, url, StringComparison.Ordinal))
                    pendingMainImageDeletion = product.ImageName;
                product.ImageName = url;
                imageUploadNotice = "Imagem enviada. Clique em “Salvar Produto” para gravar a alteração no catálogo.";
            }
            catch (InvalidOperationException ex)
            {
                imageUploadError = ex.Message;
            }
            finally
            {
                isUploading = false;
                uploadProgress = 0;
                StateHasChanged();
            }
        }
    }

    private async Task RemoveImage()
    {
        pendingMainImageDeletion = product.ImageName;
        product.ImageName = null;
        imageUploadNotice = "Imagem removida do formulário. Clique em “Salvar Produto” para confirmar a remoção.";
    }
    
    private async Task HandleAdditionalImageSelected(InputFileChangeEventArgs e)
    {
        additionalImageUploadError = string.Empty;
        // Allow up to 10 images at once
        var files = e.GetMultipleFiles(10);
        if (files.Count > 0)
        {
            isUploadingAdditional = true;
            additionalUploadProgress = 0;
            StateHasChanged();
            
            var totalFiles = files.Count;
            var processedCount = 0;

            foreach (var file in files)
            {
                // Upload each file
                IBrowserFile uploadFile = file;
                try 
                {
                    uploadFile = await file.RequestImageFileAsync("image/webp", 1200, 1200);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Image optimization failed for {file.Name}: {ex.Message}");
                }

                try
                {
                    var url = await ProductService.UploadProductImageAsync(uploadFile);
                    if (!string.IsNullOrWhiteSpace(url)) additionalImages.Add(url);
                }
                catch (InvalidOperationException ex)
                {
                    additionalImageUploadError = $"{file.Name}: {ex.Message}";
                }
                
                processedCount++;
                additionalUploadProgress = (int)((processedCount / (double)totalFiles) * 100);
                StateHasChanged();
            }
            
            isUploadingAdditional = false;
            additionalUploadProgress = 0;
            StateHasChanged();
        }
    }
    
    private async Task RemoveAdditionalImage(int index)
    {
        if (index >= 0 && index < additionalImages.Count)
        {
            var imageUrl = additionalImages[index];
            if (!string.IsNullOrEmpty(imageUrl))
            {
                await ProductService.DeleteProductImageAsync(imageUrl);
            }
            additionalImages.RemoveAt(index);
            StateHasChanged();
        }
    }
    
    private ElementReference digitalFileInputRef;

    private async Task HandleDigitalFileSelectedDirect()
    {
        digitalFileError = string.Empty;

        try
        {
            var token = await AuthService.GetCurrentUserToken();
            var result = await JSRuntime.InvokeAsync<JsUploadResult>("uploadDigitalFileDirectly", digitalFileInputRef, "api/upload/digital-file", token);
            
            if (result != null && result.Success && !string.IsNullOrEmpty(result.FilePath))
            {
                Console.WriteLine($"Upload direto concluído com sucesso: {result.FilePath}");
                product.DigitalFilePath = result.FilePath;
                Snackbar.Add($"Arquivo \"{result.FileName ?? "digital"}\" anexado com sucesso!", Severity.Success);
            }
            else
            {
                digitalFileError = result?.Error ?? "Erro ao enviar o arquivo digital. Confirme o tamanho/formato e tente novamente.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro no upload direto JS: {ex.Message}");
            digitalFileError = $"Erro de upload: {ex.Message}";
        }
        finally
        {
            isUploadingDigital = false;
            digitalUploadProgress = 0;
            StateHasChanged();
        }
    }

    public class JsUploadResult
    {
        [JsonPropertyName("success")]
        public bool Success { get; set; }

        [JsonPropertyName("filePath")]
        public string? FilePath { get; set; }

        [JsonPropertyName("fileName")]
        public string? FileName { get; set; }

        [JsonPropertyName("fileSize")]
        public long FileSize { get; set; }

        [JsonPropertyName("error")]
        public string? Error { get; set; }
    }

    private async Task HandleDigitalFileSelected(InputFileChangeEventArgs e)
    {
        digitalFileError = string.Empty;
        var file = e.File;
        if (file != null)
        {
            Console.WriteLine($"Arquivo digital selecionado: {file.Name}, Tamanho: {file.Size} bytes");
            
            var fileName = file.Name?.ToLowerInvariant() ?? "";
            var allowedExts = new[] { ".zip", ".rar", ".7z", ".stl", ".dxf", ".cdr", ".pdf", ".svg", ".obj", ".3mf" };
            var ext = Path.GetExtension(fileName);
            
            if (string.IsNullOrEmpty(ext) || !allowedExts.Contains(ext))
            {
                digitalFileError = "Envie um arquivo digital nos formatos: .ZIP, .RAR, .7Z, .STL, .DXF, .CDR, .PDF, .SVG, .OBJ, .3MF.";
                StateHasChanged();
                return;
            }

            const long maxFileSize = 250 * 1024 * 1024L;
            if (file.Size > maxFileSize)
            {
                digitalFileError = "O arquivo excede o limite máximo permitido de 250 MB.";
                StateHasChanged();
                return;
            }

            // CRITICAL BLAZOR WEBASSEMBLY FIX:
            // Read file stream INTO MEMORY IMMEDIATELY before ANY StateHasChanged call!
            // This prevents Blazor WASM from nullifying _blazorFilesById in JS interop.
            byte[] fileBytes;
            try
            {
                Console.WriteLine("Iniciando leitura do arquivo digital em memória...");
                using var stream = file.OpenReadStream(maxAllowedSize: maxFileSize);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                fileBytes = ms.ToArray();
                Console.WriteLine($"Leitura em memória concluída: {fileBytes.Length} bytes.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro ao ler stream em memória: {ex.Message}");
                digitalFileError = $"Erro ao carregar o arquivo: {ex.Message}";
                StateHasChanged();
                return;
            }

            isUploadingDigital = true;
            digitalUploadProgress = 10;
            StateHasChanged();
            
            try
            {
                Console.WriteLine("Iniciando upload para o servidor...");
                var (result, error) = await ProductService.UploadDigitalFileFromBytesAsync(fileBytes, file.Name, (progress) =>
                {
                    digitalUploadProgress = Math.Max(10, progress);
                    InvokeAsync(StateHasChanged);
                });
                
                if (result != null && (!string.IsNullOrEmpty(result.FilePath) || !string.IsNullOrEmpty(result.Url)))
                {
                    var path = !string.IsNullOrEmpty(result.FilePath) ? result.FilePath : result.Url!;
                    Console.WriteLine($"Upload do arquivo digital concluído: {path}");
                    product.DigitalFilePath = path;
                    Snackbar.Add($"Arquivo \"{file.Name}\" anexado com sucesso!", Severity.Success);
                }
                else
                {
                    digitalFileError = error ?? "Erro ao enviar o arquivo digital. Confirme o tamanho/formato e tente novamente.";
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erro durante upload digital: {ex.Message}");
                digitalFileError = $"Erro de upload: {ex.Message}";
            }
            finally
            {
                isUploadingDigital = false;
                digitalUploadProgress = 0;
                StateHasChanged();
            }
        }
    }
    
    private async Task RemoveDigitalFile()
    {
        if (string.IsNullOrEmpty(product.DigitalFilePath)) return;

        isUploadingDigital = true;
        digitalFileError = string.Empty;
        try
        {
            var removed = IsEdit
                ? await ProductService.RemoveProductDigitalFileAsync(Id!)
                : await ProductService.DeleteDigitalFileAsync(product.DigitalFilePath);

            if (removed)
            {
                product.DigitalFilePath = null;
                Snackbar.Add("Arquivo digital removido.", Severity.Success);
            }
            else
            {
                digitalFileError = "Não foi possível remover o arquivo. Tente novamente.";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao remover arquivo digital: {ex.Message}");
            digitalFileError = "Não foi possível remover o arquivo. Tente novamente.";
        }
        finally
        {
            isUploadingDigital = false;
            StateHasChanged();
        }
    }

    private async Task DownloadDigitalFile()
    {
        if (!IsEdit) return;
        isDownloadingDigital = true;
        try
        {
            var link = await ProductService.GetAdminDownloadLinkAsync(Id!);
            if (!string.IsNullOrWhiteSpace(link?.DownloadUrl))
                await JSRuntime.InvokeVoidAsync("open", link.DownloadUrl, "_blank");
            else
                Snackbar.Add("Não foi possível preparar o download do arquivo.", Severity.Error);
        }
        finally
        {
            isDownloadingDigital = false;
        }
    }
    
    // Inspection Modal State
    private string inspectionResult = "";
    private bool showInspectionModal = false;
    private bool copySuccess = false;

    private async Task InspectFile()
    {
        if (string.IsNullOrEmpty(product.DigitalFilePath)) return;

        var details = await ProductService.InspectFileVersionsAsync(product.DigitalFilePath);
        if (details != null)
        {
           inspectionResult = $"{L.Get("Admin.ProductForm.BackupReportHeader")}\n\n" +
                         $"{L.Get("Admin.ProductForm.FileLabel")} {details.Path}\n" +
                         $"{L.Get("Admin.ProductForm.ActiveVersions")} {details.VersionCount}\n" +
                         $"{L.Get("Admin.ProductForm.DeleteMarkers")} {details.DeleteMarkerCount}\n" +
                         $"{L.Get("Admin.ProductForm.TotalSize")} {details.TotalSize / 1024.0 / 1024.0:F2} MB\n\n" +
                         $"{L.Get("Admin.ProductForm.Details")}\n" + string.Join("\n", details.Details);
            
           showInspectionModal = true;
           copySuccess = false;
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("alert", L.Get("Admin.ProductForm.VerifyDetailsError"));
        }
    }

    private void CloseInspectionModal()
    {
        showInspectionModal = false;
    }

    private async Task CopyInspectionResult()
    {
        if (!string.IsNullOrEmpty(inspectionResult))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", inspectionResult);
            copySuccess = true;
            StateHasChanged();
            
            await Task.Delay(2000);
            copySuccess = false;
            StateHasChanged();
        }
    }

    
    private string GetDigitalFileName()
    {
        if (string.IsNullOrEmpty(product.DigitalFilePath))
            return string.Empty;
        
        // Extract the original filename from the storage key.
        var parts = product.DigitalFilePath.Split('/');
        var filename = parts.LastOrDefault() ?? product.DigitalFilePath;
        if (filename.Length > 33 && filename[32] == '-' && Guid.TryParseExact(filename[..32], "N", out _))
        {
            return filename[33..];
        }

        // Compatibility with legacy keys that used an underscore prefix.
        var underscoreIndex = filename.IndexOf('_');
        if (underscoreIndex > 0)
        {
            filename = filename.Substring(underscoreIndex + 1);
        }
        return filename;
    }

    private void EditSelectedCategory()
    {
        if (string.IsNullOrEmpty(product.CategoryId)) return;
        var cat = categories.FirstOrDefault(c => c.Id == product.CategoryId);
        if (cat != null)
        {
            showCategoryModal = true;
            StartEditCategory(cat);
        }
    }
    
    private void StartEditCategory(Category cat)
    {
        isEditingCategory = true;
        editingCategoryId = cat.Id;
        categoryDto = new CreateCategoryDto
        {
            Title = cat.Title,
            Priority = cat.Priority,
            ImageName = cat.ImageName
        };

        categoryTranslationModels.Clear();
        if (cat.Translations != null)
        {
            foreach (var kv in cat.Translations)
            {
                categoryTranslationModels[kv.Key] = new CategoryTranslation
                {
                    Title = kv.Value.Title,
                    ManualOverride = kv.Value.ManualOverride
                };
            }
        }
        StateHasChanged();
    }

    private void CancelEditCategory()
    {
        isEditingCategory = false;
        editingCategoryId = null;
        categoryDto = new CreateCategoryDto();
        categoryTranslationModels.Clear();
        categoryErrorMessage = string.Empty;
    }

    private async Task HandleSaveCategory()
    {
        if (string.IsNullOrWhiteSpace(categoryDto.Title)) return;

        isSavingCategory = true;
        categoryErrorMessage = string.Empty;
        
        try
        {
            // Sync translations
            categoryDto.Translations = new Dictionary<string, CategoryTranslation>();
            foreach (var kv in categoryTranslationModels)
            {
                if (!string.IsNullOrWhiteSpace(kv.Value.Title))
                {
                    kv.Value.ManualOverride = true;
                    categoryDto.Translations[kv.Key] = kv.Value;
                }
            }

            if (categoryDto.Translations.Count == 0) categoryDto.Translations = null;

            bool success;
            if (isEditingCategory && !string.IsNullOrEmpty(editingCategoryId))
            {
                var updateDto = new UpdateCategoryDto
                {
                    Id = editingCategoryId,
                    Title = categoryDto.Title,
                    Priority = categoryDto.Priority,
                    ImageName = categoryDto.ImageName,
                    Translations = categoryDto.Translations
                };
                success = await ProductService.UpdateCategoryAsync(editingCategoryId, updateDto);
            }
            else
            {
                var created = await ProductService.CreateCategoryAsync(categoryDto);
                success = created != null;
                if (created != null) product.CategoryId = created.Id;
            }

            if (success)
            {
                categories = await ProductService.GetCategoriesAsync(true);
                if (!isEditingCategory)
                {
                    showCategoryModal = false;
                }
                CancelEditCategory();
                Snackbar.Add("Categoria salva com sucesso", Severity.Success);
            }
            else
            {
                categoryErrorMessage = "Erro ao salvar categoria";
            }
        }
        catch (Exception ex)
        {
            categoryErrorMessage = $"Erro: {ex.Message}";
        }
        finally
        {
            isSavingCategory = false;
        }
    }

    private CategoryTranslation GetCategoryTranslationModel(string langCode)
    {
        if (!categoryTranslationModels.TryGetValue(langCode, out var model))
        {
            model = new CategoryTranslation();
            categoryTranslationModels[langCode] = model;
        }
        return model;
    }

    private void CancelDeleteCategory()
    {
        pendingDeleteCategoryId = null;
    }

    private async Task ConfirmDeleteCategory()
    {
        if (string.IsNullOrEmpty(pendingDeleteCategoryId)) return;
        
        var categoryId = pendingDeleteCategoryId;
        pendingDeleteCategoryId = null;
        
        Console.WriteLine($"[DEBUG] ConfirmDeleteCategory for ID: {categoryId}");
        
        var success = await ProductService.DeleteCategoryAsync(categoryId);
        Console.WriteLine($"[DEBUG] Delete result: {success}");
        
        if (success)
        {
            categories = await ProductService.GetCategoriesAsync(true);
            if (product.CategoryId == categoryId)
            {
                product.CategoryId = null;
            }
        }
        else
        {
            categoryErrorMessage = "Erro ao excluir categoria";
        }
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        // 0. Obter conteúdo do editor de texto rico
        if (QuillHtml != null)
        {
            product.FullDesc = await QuillHtml.GetHTML();
        }

        // Sync local translation models to product DTO, sanitizing empty ones and marking as ManualOverride
        product.Translations = new Dictionary<string, ProductTranslation>();
        foreach (var kvp in translationModels)
        {
            var t = kvp.Value;
            // Only include if any field has content
            if (!string.IsNullOrWhiteSpace(t.Title) || !string.IsNullOrWhiteSpace(t.Description) || !string.IsNullOrWhiteSpace(t.FullDesc))
            {
                t.ManualOverride = true; // CRITICAL: Ensure override is set for manual entries
                product.Translations[kvp.Key] = t;
            }
        }

        if (product.Translations.Count == 0) product.Translations = null;

        // 1. Validar se produto físico tem dimensões
        if (!product.IsDigital && !product.IsSubscription)
        {
            if (product.Weight <= 0 || product.Width <= 0 || product.Height <= 0 || product.Length <= 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", L.Get("Admin.ProductForm.PhysicalDimensionsRequired"));
                return;
            }
        }
        else
        {
            // Opcional: Zerar dimensões se for digital/assinatura para limpar o banco
            product.Weight = 0;
            product.Width = 0;
            product.Height = 0;
            product.Length = 0;
        }

        isSubmitting = true;
        // Reset success state just in case
        showSuccessMessage = false; 
        
        try
        {
            // Sync additional images to product before saving
            product.Images = additionalImages.Count > 0 ? new List<string>(additionalImages) : null;
            
            bool success;
            if (IsEdit)
            {
                success = await ProductService.UpdateProductAsync(Id!, product);
            }
            else
            {
                var created = await ProductService.CreateProductAsync(product);
                success = created != null;
            }

            if (success)
            {
                if (!string.IsNullOrWhiteSpace(pendingMainImageDeletion))
                {
                    await ProductService.DeleteProductImageAsync(pendingMainImageDeletion);
                    pendingMainImageDeletion = null;
                }
                // Show success via MudBlazor Snackbar with translation status
                var successMessage = L.Get("Admin.ProductForm.SuccessMessage");
                var translationMessage = product.SkipTranslation 
                    ? L.Get("Admin.ProductForm.TranslationSkipped") 
                    : L.Get("Admin.ProductForm.TranslationEnqueued");
                
                Snackbar.Add($"{successMessage} {translationMessage}", Severity.Success);
                NavigateBack();
            }
            else
            {
                Snackbar.Add("Não foi possível salvar o produto. Tente novamente.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao salvar produto: {ex.Message}");
            Snackbar.Add("Não foi possível salvar o produto. Verifique os campos e tente novamente.", Severity.Error);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private string GetDurationText(int months) => months switch
    {
        1 => L.Get("Admin.ProductForm.Duration1MonthShort"),
        3 => L.Get("Admin.ProductForm.Duration3MonthsShort"),
        6 => L.Get("Admin.ProductForm.Duration6MonthsShort"),
        12 => L.Get("Admin.ProductForm.Duration1YearShort"),
        _ => string.Format(L.Get("Admin.ProductForm.DurationMonthsFormat"), months)
    };

