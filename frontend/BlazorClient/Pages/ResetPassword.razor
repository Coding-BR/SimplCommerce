@page "/reset-password"
@inject IAuthService AuthService

<PageTitle>Nova senha | IdealCreative</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="ic-auth-page">
    <MudPaper Elevation="0" Class="ic-auth-card pa-8 bg-white">
        <div class="ic-auth-brand"><span>i</span><strong>ideal<em>creative</em></strong></div>
        <div class="text-center mb-8">
            <MudText Typo="Typo.h4" Class="fw-bold mb-2">Crie uma nova senha</MudText>
            <MudText Typo="Typo.body2" Class="ynex-text-muted">Use uma frase-senha com pelo menos 15 caracteres. Não exigimos combinações artificiais.</MudText>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <MudAlert Severity="@(success ? Severity.Success : Severity.Error)" Variant="Variant.Filled" Class="mb-6 rounded-lg ynex-alert">@message</MudAlert>
        }

        @if (!HasValidLink)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Este link de recuperação é inválido. Solicite um novo link.</MudAlert>
            <MudButton Href="/forgot-password" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6 py-3 rounded-xl fw-bold">Solicitar novo link</MudButton>
        }
        else if (success)
        {
            <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="py-3 rounded-xl fw-bold">Entrar com a nova senha</MudButton>
        }
        else
        {
            <EditForm Model="@model" OnValidSubmit="SavePassword">
                <DataAnnotationsValidator />
                <MudTextField @bind-Value="model.Password" Label="Nova senha" Variant="Variant.Outlined" InputType="InputType.Password" Immediate="true" For="@(() => model.Password)" FullWidth="true" Class="mb-4" />
                <MudTextField @bind-Value="model.ConfirmPassword" Label="Confirme a nova senha" Variant="Variant.Outlined" InputType="InputType.Password" Immediate="true" For="@(() => model.ConfirmPassword)" FullWidth="true" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6 py-3 rounded-xl fw-bold" Disabled="@saving">
                    @if (saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" /> <span class="ms-2">Salvando...</span> }
                    else { <span>Redefinir senha</span> }
                </MudButton>
            </EditForm>
        }

        <div class="text-center mt-8">
            <MudLink Href="/login" Underline="Underline.None" Color="Color.Primary" Class="fw-bold">Voltar para entrar</MudLink>
        </div>
    </MudPaper>
</MudContainer>

@code {
    [Parameter, SupplyParameterFromQuery] public string? Email { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? Token { get; set; }

    private readonly ResetPasswordModel model = new();
    private bool saving;
    private bool success;
    private string? message;
    private bool HasValidLink => !string.IsNullOrWhiteSpace(Email) && !string.IsNullOrWhiteSpace(Token);

    private async Task SavePassword()
    {
        if (model.Password != model.ConfirmPassword)
        {
            success = false;
            message = "As senhas não coincidem.";
            return;
        }

        saving = true;
        message = null;
        var result = await AuthService.ResetPassword(Email!, Token!, model.Password);
        saving = false;
        success = result.Success;
        message = result.Success ? result.Message ?? "Senha alterada com sucesso." : result.Error ?? "Não foi possível redefinir a senha.";
    }

    private sealed class ResetPasswordModel
    {
        [Required(ErrorMessage = "A nova senha é obrigatória")]
        [MinLength(15, ErrorMessage = "A senha deve ter pelo menos 15 caracteres")]
        [MaxLength(128, ErrorMessage = "A senha deve ter no máximo 128 caracteres")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "A confirmação da senha é obrigatória")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
