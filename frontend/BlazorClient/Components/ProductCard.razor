@using BlazorClient.Models
@using BlazorClient.Core.Services
@using BlazorClient.Core.Interfaces
@inject IClientLocaleService LocaleService
@inject ILocalizationService L
@inject NavigationManager Navigation
@inject ICartService CartService
@inject ISnackbar Snackbar

<div class="ynex-product-card-premium" @onclick="NavigateToDetails">
    <div class="product-image-wrapper rounded-2xl overflow-hidden relative border">
        <img src="@(string.IsNullOrEmpty(Product.ImageName) ? "assets/img/product/default-placeholder.png" : Product.ImageName)" 
             alt="@Product.Title" 
             width="600" height="600"
             loading="@(Priority ? "eager" : "lazy")"
             fetchpriority="@(Priority ? "high" : "auto")"
             decoding="async"
             class="product-main-image" />
        
        <div class="product-badges-overlay pa-3">
            @if (Product.IsDigital)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Class="fw-bold rounded-lg shadow-sm">@L.Get("Product.Digital")</MudChip>
            }
            @if (!Product.IsDigital)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Class="fw-bold rounded-lg shadow-sm">@L.Get("Product.Physical")</MudChip>
            }
        </div>

        <div class="product-actions-hover">
            <MudTooltip Text="@L.Get("Product.ViewDetails")">
                <MudFab Color="Color.Surface" StartIcon="@Icons.Material.Filled.Visibility" Size="Size.Small" Class="hover-scale shadow-4" OnClick="NavigateToDetails" />
            </MudTooltip>
            <MudTooltip Text="@L.Get("Product.AddToCart")">
                <div @onclick:stopPropagation="true" class="d-inline-block">
                    <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Small" Class="hover-scale shadow-4" OnClick="AddToCart" />
                </div>
            </MudTooltip>
        </div>
    </div>
    <div class="product-info-wrapper pa-4 text-center">
        @if (!string.IsNullOrEmpty(Product.CategoryName))
        {
            <div class="d-flex justify-center mb-1">
                <span class="category-badge">@Product.CategoryName</span>
            </div>
        }

        <MudText Typo="Typo.subtitle1" Class="fw-bold line-clamp-1 mb-1 product-title-hover transition-all">
            @Product.GetTranslatedTitle(LocaleService.CurrentLocale.Language)
        </MudText>
        
        @if (Product.TagsArray != null && Product.TagsArray.Any())
        {
            <div class="product-tags-list d-flex flex-wrap justify-center gap-1 mb-2">
                @foreach (var tag in Product.TagsArray.Take(3))
                {
                    <span class="tag-badge">#@tag</span>
                }
            </div>
        }
        
        @if (Product.ReviewCount > 0)
        {
            <div class="d-flex align-center justify-center mb-2">
                <MudRating ReadOnly="true" SelectedValue="@((int)Math.Round(Product.AverageRating))" Size="Size.Small" Color="Color.Warning" />
                <MudText Typo="Typo.caption" Class="ml-1 ynex-text-muted">(@Product.ReviewCount)</MudText>
            </div>
        }

        <div class="d-flex align-center justify-center">
            <MudText Typo="Typo.h6" Color="Color.Primary" Class="fw-bold">
                @LocaleService.FormatPrice((double)Product.Price, (decimal?)Product.Price, Product.Currency)
            </MudText>
        </div>
    </div>
</div>

@code {
    [Parameter] public Product Product { get; set; } = default!;
    [Parameter] public EventCallback<Product> OnAddToCart { get; set; }
    [Parameter] public bool Priority { get; set; }

    private void NavigateToDetails()
    {
        Navigation.NavigateTo($"/product/{Product.Id}");
    }

    private async Task AddToCart()
    {
        if (OnAddToCart.HasDelegate)
        {
            await OnAddToCart.InvokeAsync(Product);
        }
        else 
        {
            try 
            {
                if (!Product.IsDigital)
                {
                    NavigateToDetails();
                    return;
                }

                var cartItem = new CartItem
                {
                    ProductId = Product.Id,
                    ProductTitle = Product.Title ?? "Product",
                    ProductImage = Product.ImageName,
                    Price = Product.Price,
                    DisplayPrice = Product.DisplayPrice,
                    DisplayCurrency = Product.DisplayCurrency,
                    Quantity = 1,
                    IsDigital = Product.IsDigital
                };
                
                await CartService.AddToCart(cartItem);
                Snackbar.Add(L.Get("Cart.AddedSuccess"), Severity.Success);
            }
            catch(Exception ex)
            {
                Console.WriteLine(ex.Message);
                Snackbar.Add("Error adding to cart", Severity.Error);
            }
        }
    }
}
