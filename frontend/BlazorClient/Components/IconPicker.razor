@using Microsoft.AspNetCore.Components.Web

<div class="icon-picker-container">
    @if (ShowInput)
    {
        <div class="input-group">
            <input type="text" class="form-control" value="@Value" readonly @onclick="OpenModal" placeholder="Selecione um ícone..." />
            <div class="input-group-append">
                <span class="input-group-text cursor-pointer" @onclick="OpenModal">
                    <i class="@(string.IsNullOrEmpty(Value) ? "icon-question" : Value)"></i>
                </span>
            </div>
        </div>
    }

    @if (IsModalOpen)
    {
        <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Selecionar Ícone</h5>
                        <button type="button" class="close" @onclick="CloseModal" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        <div class="form-group mb-3">
                            <input type="text" class="form-control" placeholder="Buscar ícone..." 
                                   @bind="SearchTerm" @bind:event="oninput" />
                        </div>

                        <ul class="nav nav-tabs mb-3">
                            <li class="nav-item">
                                <a class="nav-link @(ActiveCategory == "All" ? "active" : "")" @onclick='() => SetCategory("All")' href="javascript:void(0)">Todos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ActiveCategory == "Simple" ? "active" : "")" @onclick='() => SetCategory("Simple")' href="javascript:void(0)">Simple Line</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(ActiveCategory == "Ionicons" ? "active" : "")" @onclick='() => SetCategory("Ionicons")' href="javascript:void(0)">Ionicons</a>
                            </li>
                        </ul>

                        <div class="icon-grid">
                            @foreach (var icon in FilteredIcons)
                            {
                                <div class="icon-item @(Value == icon ? "selected" : "")" @onclick="() => SelectIcon(icon)">
                                    <i class="@icon"></i>
                                    <span class="icon-name" title="@icon">@FormatIconName(icon)</span>
                                </div>
                            }
                            @if (!FilteredIcons.Any())
                            {
                                <div class="col-12 text-center py-5">
                                    <p class="text-muted">Nenhum ícone encontrado para "@SearchTerm"</p>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .icon-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 10px;
        max-height: 400px;
        overflow-y: auto;
        padding: 5px;
    }
    .icon-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 10px;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
        height: 80px;
    }
    .icon-item:hover {
        background-color: #f8f9fa;
        border-color: #adb5bd;
        transform: translateY(-2px);
    }
    .icon-item.selected {
        background-color: #e8f0fe;
        border-color: #4285f4;
        color: #4285f4;
    }
    .icon-item i {
        font-size: 24px;
        margin-bottom: 5px;
    }
    .icon-name {
        font-size: 10px;
        text-align: center;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        width: 100%;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>
